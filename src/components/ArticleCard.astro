---
import { formatDate, sourceHost } from '../lib/articles';

interface Props {
  id: string;
  title: string;
  date: Date;
  summary: string;
  company: string;
  priority: string;
  source: string;
  sourceName?: string;
}

const { id, title, date, summary, company, priority, source, sourceName } = Astro.props;
---

<article class="card reveal">
  <a class="card-link" href={`/articles/${id}/`}>
    <header class="top">
      <span class="chip chip--accent">{company}</span>
      {priority === 'High' && <span class="chip chip--high">🔥 High</span>}
      <time class="date" datetime={date.toISOString()}>{formatDate(date)}</time>
    </header>

    <h3>{title}</h3>
    <p class="summary">{summary}</p>

    <footer class="bottom">
      <span class="source">{sourceName ?? sourceHost(source)}</span>
      <span class="read">Read <span class="arrow" aria-hidden="true">→</span></span>
    </footer>
  </a>
</article>

<style>
  .card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.28s var(--ease),
      box-shadow 0.28s var(--ease),
      border-color 0.28s var(--ease);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--line-strong);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 26px;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .date {
    margin-left: auto;
    font-size: 12.5px;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .summary {
    font-size: 15px;
    color: var(--ink-2);
    line-height: 1.55;
    /* Keep cards a consistent height without clipping mid-word. */
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bottom {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
  }

  .source {
    color: var(--ink-3);
  }

  .read {
    font-weight: 600;
    color: var(--violet);
  }

  .read .arrow {
    display: inline-block;
    transition: transform 0.22s var(--ease);
  }

  .card:hover .read .arrow {
    transform: translateX(4px);
  }
</style>
