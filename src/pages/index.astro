---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getPublishedArticles, formatDate } from '../lib/articles';
import { site } from '../site.config';

const articles = await getPublishedArticles();
const latest = articles.slice(0, 12);
const lastUpdated = articles[0]?.data.date;
---

<BaseLayout>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow rise"><span class="dot"></span> New stories every day</span>
      <h1 class="rise headline">
        The AI news that actually{' '}
        <span class="gradient-text">changes how you work.</span>
      </h1>
      <p class="lede rise sub">{site.description}</p>

      <div class="stats rise">
        <span><strong>{articles.length}</strong> stories tracked</span>
        {lastUpdated && <span>Last updated <strong>{formatDate(lastUpdated)}</strong></span>}
      </div>
    </div>
  </section>

  <section class="feed">
    <div class="wrap">
      <div class="feed-head">
        <h2>Latest</h2>
        <a class="btn btn--ghost" href="/archive">
          Browse the archive
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      {
        latest.length === 0 ? (
          <p class="empty">
            No stories yet — the first daily run will drop them right here.
          </p>
        ) : (
          <div class="grid">
            {latest.map((article) => (
              <ArticleCard
                id={article.id}
                title={article.data.title}
                date={article.data.date}
                summary={article.data.summary}
                company={article.data.company}
                priority={article.data.priority}
                source={article.data.source}
                sourceName={article.data.sourceName}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: clamp(64px, 10vw, 120px) 0 clamp(48px, 6vw, 72px);
    overflow: hidden;
  }

  /* Wide, very soft gradient bloom behind the headline. */
  .hero::before {
    content: '';
    position: absolute;
    top: -280px;
    left: 50%;
    translate: -50% 0;
    width: min(1000px, 120vw);
    height: 620px;
    background: var(--grad);
    filter: blur(130px);
    opacity: 0.14;
    pointer-events: none;
  }

  .hero .wrap {
    position: relative;
  }

  .headline {
    margin-top: 18px;
    max-width: 17ch;
  }

  .sub {
    margin-top: 22px;
  }

  /* Stagger the hero elements so they cascade in. */
  .hero .rise:nth-child(1) {
    animation-delay: 0.02s;
  }
  .hero .rise:nth-child(2) {
    animation-delay: 0.1s;
  }
  .hero .rise:nth-child(3) {
    animation-delay: 0.18s;
  }
  .hero .rise:nth-child(4) {
    animation-delay: 0.26s;
  }

  .stats {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    font-size: 14px;
    color: var(--ink-3);
  }

  .stats strong {
    color: var(--ink);
    font-weight: 620;
  }

  .feed {
    padding-top: 8px;
  }

  .feed-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }

  /* Cascade the cards in as the grid scrolls into view. */
  .grid > :global(.card:nth-child(3n + 2)) {
    transition-delay: 0.07s;
  }
  .grid > :global(.card:nth-child(3n + 3)) {
    transition-delay: 0.14s;
  }

  .empty {
    padding: 48px;
    text-align: center;
    color: var(--ink-3);
    background: var(--bg);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 560px) {
    .feed-head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
