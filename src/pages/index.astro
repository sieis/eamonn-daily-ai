---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getPublishedArticles, formatDate } from '../lib/articles';
import { site, intro, cta } from '../site.config';

const articles = await getPublishedArticles();
const latest = articles.slice(0, 12);
const lastUpdated = articles[0]?.data.date;

// Only render the portrait once the file actually exists in /public — otherwise
// show initials so a missing headshot never turns into a broken image.
const hasPhoto = existsSync(fileURLToPath(new URL(`../../public${site.authorPhoto}`, import.meta.url)));
const initials = site.author
  .split(' ')
  .map((word) => word[0])
  .join('');
---

<BaseLayout>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow rise"><span class="dot"></span> New stories every day</span>
        <h1 class="rise headline">
          AI and automation news that{' '}
          <span class="gradient-text">affects how you work.</span>
        </h1>
        <p class="lede rise sub">{site.description}</p>

        <div class="byline rise">
          {
            hasPhoto ? (
              <img
                class="avatar"
                src={site.authorPhoto}
                width="112"
                height="112"
                alt={site.author}
                decoding="async"
              />
            ) : (
              <span class="avatar avatar--initials" aria-hidden="true">
                {initials}
              </span>
            )
          }
          <span class="byline-text">
            <strong>{site.author}</strong>
            <span class="byline-role">{site.authorRole}</span>
          </span>
        </div>

        <div class="actions rise">
          <a class="btn btn--primary" href={cta.buttonHref} target="_blank" rel="noopener noreferrer">
            {cta.buttonLabel}
            <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost" href="#latest">Read today’s stories</a>
        </div>

        <div class="stats rise">
          <span><strong>{articles.length}</strong> stories tracked</span>
          {lastUpdated && <span>Last updated <strong>{formatDate(lastUpdated)}</strong></span>}
        </div>
      </div>

      <div class="hero-media rise">
        <div class="video">
          <iframe
            src={`https://www.youtube.com/embed/${intro.videoId}?rel=0`}
            title={intro.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen></iframe>
        </div>
        <p class="video-cap">{intro.caption}</p>
      </div>
    </div>
  </section>

  <section class="feed" id="latest">
    <div class="wrap">
      <div class="feed-head">
        <h2>Latest</h2>
        <a class="btn btn--ghost" href="/archive">
          Browse the archive
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      {
        latest.length === 0 ? (
          <p class="empty">
            No stories yet — the first daily run will drop them right here.
          </p>
        ) : (
          <div class="grid">
            {latest.map((article) => (
              <ArticleCard
                id={article.id}
                title={article.data.title}
                date={article.data.date}
                summary={article.data.summary}
                company={article.data.company}
                priority={article.data.priority}
                source={article.data.source}
                sourceName={article.data.sourceName}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: clamp(64px, 10vw, 120px) 0 clamp(48px, 6vw, 72px);
    overflow: hidden;
  }

  /* Wide, very soft gradient bloom behind the headline. */
  .hero::before {
    content: '';
    position: absolute;
    top: -280px;
    left: 50%;
    translate: -50% 0;
    width: min(1000px, 120vw);
    height: 620px;
    background: var(--grad);
    filter: blur(130px);
    opacity: 0.14;
    pointer-events: none;
  }

  .hero .wrap {
    position: relative;
  }

  /* Copy on the left, intro video on the right; stacks under 940px. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
  }

  /* Slightly smaller than the global h1 — it shares the row with the video. */
  .headline {
    margin-top: 18px;
    max-width: 16ch;
    font-size: clamp(2.4rem, 4.4vw, 3.5rem);
  }

  .sub {
    margin-top: 22px;
  }

  /* Stagger the hero elements so they cascade in. */
  .hero-copy > .rise:nth-child(1) {
    animation-delay: 0.02s;
  }
  .hero-copy > .rise:nth-child(2) {
    animation-delay: 0.08s;
  }
  .hero-copy > .rise:nth-child(3) {
    animation-delay: 0.14s;
  }
  .hero-copy > .rise:nth-child(4) {
    animation-delay: 0.2s;
  }
  .hero-copy > .rise:nth-child(5) {
    animation-delay: 0.26s;
  }
  .hero-copy > .rise:nth-child(6) {
    animation-delay: 0.32s;
  }
  .hero-media {
    animation-delay: 0.2s;
  }

  .byline {
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }

  .avatar--initials {
    display: grid;
    place-items: center;
    background: var(--grad);
    border-color: transparent;
    color: #fff;
    font-size: 15px;
    font-weight: 640;
    letter-spacing: -0.01em;
  }

  .byline-text {
    display: grid;
    font-size: 14.5px;
    line-height: 1.35;
  }

  .byline-text strong {
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  .byline-role {
    color: var(--ink-3);
  }

  .actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* 16:9 frame so the embed scales with the column on every screen. */
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--ink);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }

  .video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-cap {
    margin-top: 14px;
    font-size: 14px;
    color: var(--ink-3);
    text-align: center;
    text-wrap: balance;
  }

  .stats {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    font-size: 14px;
    color: var(--ink-3);
  }

  .stats strong {
    color: var(--ink);
    font-weight: 620;
  }

  .feed {
    padding-top: 8px;
  }

  .feed-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }

  /* Cascade the cards in as the grid scrolls into view. */
  .grid > :global(.card:nth-child(3n + 2)) {
    transition-delay: 0.07s;
  }
  .grid > :global(.card:nth-child(3n + 3)) {
    transition-delay: 0.14s;
  }

  .empty {
    padding: 48px;
    text-align: center;
    color: var(--ink-3);
    background: var(--bg);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 940px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .headline {
      max-width: 17ch;
    }

    .hero-media {
      max-width: 640px;
    }

    .video-cap {
      text-align: left;
    }
  }

  @media (max-width: 560px) {
    .feed-head {
      flex-direction: column;
      align-items: flex-start;
    }

    .actions .btn {
      flex: 1 1 auto;
      justify-content: center;
    }
  }
</style>
