---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import { getPublishedArticles, dayKey, formatDate } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article: { id: string }) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { data } = article;
const day = dayKey(data.date);
---

<BaseLayout title={data.title} description={data.summary}>
  <article class="post">
    <div class="wrap narrow">
      <a class="back" href={`/days/${day}/#${article.id}`}>
        <span class="arrow" aria-hidden="true">←</span> All stories from {formatDate(data.date)}
      </a>

      <div class="body">
        <ArticleBody article={article} headingLevel={1} />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding: clamp(36px, 6vw, 72px) 0 0;
  }

  .narrow {
    max-width: 760px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14px;
    font-weight: 550;
    color: var(--ink-3);
    transition: color 0.2s var(--ease);
  }

  .back:hover {
    color: var(--accent);
  }

  .back .arrow {
    display: inline-block;
    transition: transform 0.2s var(--ease);
  }

  .back:hover .arrow {
    transform: translateX(-3px);
  }

  .body {
    margin-top: 28px;
  }
</style>
